FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install --no-cache-dir uv

# Copy requirements
COPY requirements.txt .

# Install Python deps
RUN uv pip install --system --no-cache -r requirements.txt

# Download ONNX model from GitHub Release
RUN curl -L \
  https://github.com/Vivekkumar-IN/Onxx/releases/download/v1.0/onnx_model.zip \
  -o onnx_model.zip \
  && unzip onnx_model.zip \
  && rm onnx_model.zip

# Copy app code
COPY main.onxx.py .

EXPOSE 8080

CMD ["python", "main.onxx.py"]